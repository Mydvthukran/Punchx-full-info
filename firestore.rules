rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Catch-All for Frontend Demo Mode
    // NamoID lacks standard OIDC discovery, preventing Firebase Auth integration.
    // UI is protected by NamoID, but database is open for the demo.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
